APP_NAME="Laravel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=couples
DB_USERNAME=couples
DB_PASSWORD=couples_dev_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Encrypted photo storage. Primary and backup MUST use separate credentials,
# ideally separate providers/accounts. Values below match docker/storage (dev only).
PHOTOS_PRIMARY_ENDPOINT=http://storage-primary:8333
PHOTOS_PRIMARY_BUCKET=photos-primary
PHOTOS_PRIMARY_REGION=us-east-1
PHOTOS_PRIMARY_PATH_STYLE=true
PHOTOS_PRIMARY_ACCESS_KEY=dev-primary-app
PHOTOS_PRIMARY_SECRET_KEY=dev-primary-app-secret

PHOTOS_BACKUP_ENDPOINT=http://storage-backup:8333
PHOTOS_BACKUP_BUCKET=photos-backup
PHOTOS_BACKUP_REGION=us-east-1
PHOTOS_BACKUP_PATH_STYLE=true
PHOTOS_BACKUP_ACCESS_KEY=dev-backup-app
PHOTOS_BACKUP_SECRET_KEY=dev-backup-app-secret

PHOTOS_TRASH_RETENTION_DAYS=30
PHOTOS_BACKUP_RETENTION_DAYS=30
PHOTOS_ABANDONED_UPLOAD_HOURS=24

DB_BACKUP_ENDPOINT=http://storage-backup:8333
DB_BACKUP_BUCKET=db-backups
DB_BACKUP_REGION=us-east-1
DB_BACKUP_PATH_STYLE=true
DB_BACKUP_ACCESS_KEY=dev-db-backup
DB_BACKUP_SECRET_KEY=dev-db-backup-secret
# Generate with: php artisan db:backup-keygen (keep the secret key offline)
DB_BACKUP_PUBLIC_KEY=
# Operator-only. Dev/drill environments only; never set in production.
DB_BACKUP_RESTORE_IDENTITY=
