# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION environment template. Copy to deploy/env/production.env ON THE
# SERVER ONLY (chmod 600, owned by the deploy user). Never commit the copy.
# Every <...> must be replaced. Values marked SECRET come from the secret store.
# Used both by docker compose (--env-file) and by the containers (APP_ENV_FILE).
# ─────────────────────────────────────────────────────────────────────────────

# Compose
COMPOSE_PROJECT_NAME=couples-prod
APP_ENV_FILE=./env/production.env
APP_IMAGE=<registry>/couples-app:<git-sha>
WEB_IMAGE=<registry>/couples-web:<git-sha>
DOMAIN=api.<your-domain>
ACME_EMAIL=<ops-email>
# Space-separated CIDRs allowed to reach /admin (VPN/office). Required in production.
ADMIN_ALLOWED_CIDRS=<vpn-cidr>
PHP_FPM_MAX_CHILDREN=10
PG_MAX_CONNECTIONS=100

# Laravel
APP_NAME="Couples App"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                        # SECRET: php artisan key:generate --show (unique per environment)
APP_URL=https://api.<your-domain>
LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL=info
TRUSTED_PROXIES=*               # only Caddy/Nginx on private networks can reach the app

# PostgreSQL (dedicated to production)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=couples_production
DB_USERNAME=couples_production
DB_PASSWORD=                    # SECRET

# Redis (password required; not published outside the internal network)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                 # SECRET
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

# Security
API_TOKEN_TTL_DAYS=60
ADMIN_MFA_REQUIRED=true
ADMIN_ALLOWED_IPS=              # optional second layer behind Caddy (CIDRs, comma-separated)
CORS_ALLOWED_ORIGINS=
HEALTH_CHECK_TOKEN=             # SECRET: random 32+ chars, only for the uptime monitor

# Monitoring (dead-man's switch URLs from your monitoring provider)
HEARTBEAT_URL_SCHEDULER=
HEARTBEAT_URL_QUEUE=
ALERT_LOG_CHANNELS=stderr,slack
LOG_SLACK_WEBHOOK_URL=          # SECRET

# Photo storage — PRIMARY (provider A, private bucket, app-scoped key: put/get/list/delete on this bucket only)
PHOTOS_PRIMARY_ENDPOINT=<https://provider-a-endpoint>
PHOTOS_PRIMARY_BUCKET=<bucket>
PHOTOS_PRIMARY_REGION=<region>
PHOTOS_PRIMARY_PATH_STYLE=false
PHOTOS_PRIMARY_ACCESS_KEY=      # SECRET
PHOTOS_PRIMARY_SECRET_KEY=      # SECRET

# Photo storage — BACKUP (provider B or separate account, object lock COMPLIANCE, key without delete-version rights)
PHOTOS_BACKUP_ENDPOINT=<https://provider-b-endpoint>
PHOTOS_BACKUP_BUCKET=<bucket>
PHOTOS_BACKUP_REGION=<region>
PHOTOS_BACKUP_PATH_STYLE=false
PHOTOS_BACKUP_ACCESS_KEY=       # SECRET
PHOTOS_BACKUP_SECRET_KEY=       # SECRET

PHOTOS_TRASH_RETENTION_DAYS=30
PHOTOS_BACKUP_RETENTION_DAYS=30
PHOTOS_ABANDONED_UPLOAD_HOURS=24

# Encrypted DB backups (provider B, own bucket + key). Only the PUBLIC key is here.
DB_BACKUP_ENDPOINT=<https://provider-b-endpoint>
DB_BACKUP_BUCKET=<bucket>
DB_BACKUP_REGION=<region>
DB_BACKUP_PATH_STYLE=false
DB_BACKUP_ACCESS_KEY=           # SECRET
DB_BACKUP_SECRET_KEY=           # SECRET
DB_BACKUP_PUBLIC_KEY=           # from php artisan db:backup-keygen; secret half stays OFFLINE
DB_BACKUP_RESTORE_IDENTITY=     # MUST stay empty in production

# Billing — mock store is forced off outside local/testing; real providers need credentials (not yet implemented).
BILLING_MOCK_ENABLED=false

MAIL_MAILER=log
